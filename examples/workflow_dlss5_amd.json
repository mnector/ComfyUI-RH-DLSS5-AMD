{
  "1": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "example.png"
    }
  },
  "2": {
    "class_type": "RH_DLSS5Enhance_AMD",
    "inputs": {
      "image": ["1", 0],
      "enable_nr": true,
      "neural_runtime": "danielblnc 0.5.1",
      "upscaling_mode": "2x (Performance)",
      "nr_style": "Full Model Look",
      "neural_placement": "After upscaling",
      "nr_resolution": 100,
      "neural_passes": 1,
      "full_network": true,
      "fast_mode": false,
      "dynamic_nr_resolution": false,
      "model_interleave": "Off",
      "residual_strength": 1.0,
      "residual_limit": 0.0,
      "temporal_stability": 0.50,
      "sharpening": 0.0,
      "colour_composition": "Classic",
      "detail_strength": 2.0,
      "colour_strength": 1.0,
      "motion": "auto",
      "keep_audio": "on",
      "backend": "amd_nr_bridge",
      "runtime_dir": ""
    }
  },
  "3": {
    "class_type": "RH_DLSS5FrameInterpolation_AMD",
    "inputs": {
      "image": ["2", 0],
      "output_fps": "2x",
      "motion": "auto",
      "scene_change_threshold": 0.24,
      "keep_audio": "on",
      "runtime_dir": "",
      "wine_prefix": ""
    }
  },
  "4": {
    "class_type": "SaveImage",
    "inputs": {
      "images": ["3", 0],
      "filename_prefix": "dlss5_amd_enhanced_interpolated"
    }
  }
}
