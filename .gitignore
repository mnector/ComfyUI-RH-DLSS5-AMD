# ==========================================
# Git Ignore for ComfyUI-RH-DLSS5-AMD
# Strict filtering for runtimes, binaries & local private configs
# ==========================================

# Local private environment files (STRICT PRIVACY)
.env
.env.*
.env.local
*.local
*.local.*

# Python cache & build files
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
venv/
.eggs/

# IDE & Editor files
.vs/
.vscode/
.idea/
*.swp
*.swo
*~

# Compiled binaries, libraries & runtimes (STRICT)
*.dll
*.exe
*.pak
*.pyd
*.so
*.lib
*.exp
*.dylib

# Whitelist bundled open-source host & bridge shims from upstream
!native/bin/dlss5nr_bridge.dll
!native/bin/dlss5nr_host.exe
!native/bin/dlss_bridge.exe
!runtime/caller/nvngx.dll_comfy.dll

# Runtime folder contents (user-supplied weights/runtimes strictly excluded)
runtime/*
!runtime/README.txt
!runtime/.gitkeep
!runtime/caller/
!runtime/caller/nvngx.dll_comfy.dll
!runtime/caller/.gitkeep

# Model weights & Checkpoints (STRICT)
*.ckpt
*.safetensors
*.pth
*.pt
*.bin
*.onnx
*.gguf
*.engine
*.trt
*.tflite
models/
weights/

# Video, audio, temporary media & 3D assets
*.mp4
*.mkv
*.mov
*.avi
*.webm
*.wav
*.flac
*.mp3
*.glb
*.gltf
*.obj
save_audio/
temp/
output/
outputs/

# Logs & temporary files
*.log
*.tmp

# System & OS files
Thumbs.db
Desktop.ini
.DS_Store
# Critical Privacy & Binary Shields
.env*
*.local*
